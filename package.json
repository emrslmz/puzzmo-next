{
  "name": "puzzmo",
  "description": "puzzmo by emresolmaz.com.tr",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port=5757 --host",
    "build": "vite build",
    "preview": "vite preview --port=5758 --host",
    "assets": "node scripts/build-assets.mjs",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "sync": "npm run build && npx cap sync",
    "deploy:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "deploy:android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/device": "^7.0.5",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/screen-orientation": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@revenuecat/purchases-capacitor": "^10.4.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@capacitor/cli": "^7.6.9",
    "eslint": "^10.12.0",
    "sharp": "^0.35.5",
    "vite": "^7.3.7"
  }
}
